---
import '../../styles/button.css';

interface Props {
  title: string;
  headingLevel?: 1 | 2;
  eyebrow?: string;
  description?: string;
  action?: {
    label: string;
    href: string;
  };
}

const { title, headingLevel = 1, eyebrow, description, action } = Astro.props;
---

<section class="section marketing-hero">
  <div class="wrapper marketing-hero__content">
    {eyebrow && <p class="marketing-hero__eyebrow">{eyebrow}</p>}
    {headingLevel === 1 ? (
      <h1 class="marketing-hero__title">{title}</h1>
    ) : (
      <h2 class="marketing-hero__title">{title}</h2>
    )}
    {description && <p class="marketing-hero__description">{description}</p>}
    {action && (
      <a class="button button--primary marketing-hero__action" href={action.href}>
        {action.label}
      </a>
    )}
  </div>
</section>

<style>
  .marketing-hero__content {
    max-width: 48rem;
  }

  .marketing-hero__eyebrow {
    margin: 0;
    color: var(--color-text-default);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--font-tracking-extended);
    text-transform: uppercase;
  }

  .marketing-hero__title {
    margin: var(--spacing-2) 0 0;
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--font-tracking-tight);
    line-height: var(--font-leading-3xl);
  }

  .marketing-hero__description {
    max-width: 42rem;
    margin: var(--spacing-3) 0 0;
    color: color-mix(in srgb, var(--color-text-default) 75%, transparent);
    font-size: var(--font-size-md);
    line-height: var(--font-leading-lg);
  }

  .marketing-hero__action {
    margin-top: var(--spacing-4);
  }

  @media (--sm) {
    .marketing-hero__title {
      font-size: var(--font-size-6xl);
      line-height: var(--font-leading-6xl);
    }
  }
</style>
