---
import { siteConfig } from '../../config/site.config';

const { stickyHeader, backToTop } = siteConfig.features;
---

{backToTop && (
  <a class="back-to-top" href="#top" aria-label="Volver arriba">
    <span aria-hidden="true">↑</span>
  </a>
)}

<style>
  .back-to-top {
    position: fixed;
    right: var(--wrapper-gutter-mobile);
    bottom: var(--space-4);
    z-index: 30;
    display: inline-grid;
    width: var(--size-control);
    height: var(--size-control);
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-6);
    font-size: var(--size-icon);
    line-height: 1;
  }

  .back-to-top--enhanced {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(var(--space-4));
    transition:
      opacity var(--motion-fast) ease,
      transform var(--motion-fast) ease,
      visibility var(--motion-fast) ease;
  }

  .back-to-top--enhanced.back-to-top--visible {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  @media (min-width: 37.5rem) {
    .back-to-top {
      right: var(--wrapper-gutter-tablet);
    }
  }

  @media (min-width: 75rem) {
    .back-to-top {
      right: var(--wrapper-gutter-desktop);
    }
  }
</style>

{(stickyHeader || backToTop) && <script define:vars={{ stickyHeader, backToTop }}>
  const stickyHeaderThreshold = 240;
  const backToTopThreshold = 640;
  const header = document.querySelector('.site-header');
  const backToTopLink = document.querySelector('.back-to-top');

  backToTopLink?.classList.add('back-to-top--enhanced');

  let framePending = false;
  const syncScrollControls = () => {
    const isPastStickyThreshold = window.scrollY >= stickyHeaderThreshold;
    const isPastBackToTopThreshold = window.scrollY >= backToTopThreshold;

    if (stickyHeader) header?.classList.toggle('site-header--sticky', isPastStickyThreshold);
    if (backToTop)
      backToTopLink?.classList.toggle('back-to-top--visible', isPastBackToTopThreshold);

    framePending = false;
  };

  const requestSync = () => {
    if (framePending) return;
    framePending = true;
    window.requestAnimationFrame(syncScrollControls);
  };

  window.addEventListener('scroll', requestSync, { passive: true });
  requestSync();
</script>}
