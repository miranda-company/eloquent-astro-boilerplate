---
import { siteConfig } from '../../config/client-config';

const { stickyHeader, backToTop } = siteConfig.features;
---

{backToTop && (
  <a class="back-to-top" href="#top" aria-label="Volver arriba">
    <span aria-hidden="true">↑</span>
  </a>
)}

<style>
  .back-to-top {
    position: fixed;
    right: var(--spacing-wrapper-default);
    bottom: var(--spacing-2);
    z-index: 30;
    display: inline-grid;
    width: var(--spacing-5);
    height: var(--spacing-5);
    place-items: center;
    border: var(--border-size-sm) solid var(--color-border-secondary);
    border-radius: var(--radius-3xl);
    background: var(--color-surface-brand);
    color: var(--color-text-default);
    font-size: var(--font-size-md);
    line-height: var(--font-leading-lg);
  }

  .back-to-top--enhanced {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(var(--spacing-2));
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 160ms ease;
  }

  .back-to-top--enhanced.back-to-top--visible {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top--enhanced {
      transition: none;
      transform: none;
    }
  }
</style>

{(stickyHeader || backToTop) && <script define:vars={{ stickyHeader, backToTop }}>
  const stickyHeaderThreshold = 240;
  const backToTopThreshold = 640;
  const header = document.querySelector('.site-header');
  const backToTopLink = document.querySelector('.back-to-top');

  backToTopLink?.classList.add('back-to-top--enhanced');

  let framePending = false;
  const syncScrollControls = () => {
    const isPastStickyThreshold = window.scrollY >= stickyHeaderThreshold;
    const isPastBackToTopThreshold = window.scrollY >= backToTopThreshold;

    if (stickyHeader) header?.classList.toggle('site-header--sticky', isPastStickyThreshold);
    if (backToTop)
      backToTopLink?.classList.toggle('back-to-top--visible', isPastBackToTopThreshold);

    framePending = false;
  };

  const requestSync = () => {
    if (framePending) return;
    framePending = true;
    window.requestAnimationFrame(syncScrollControls);
  };

  window.addEventListener('scroll', requestSync, { passive: true });
  requestSync();
</script>}
