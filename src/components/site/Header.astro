---
import { siteConfig } from '../../config/site.config';

interface Props {
  showNavigation?: boolean;
}
const { showNavigation = true } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner wrapper">
    <a class="site-header__logo-link" href="/">
      <img
        class="site-header__logo"
        src={siteConfig.brand.logo}
        width={siteConfig.brand.logoWidth}
        height={siteConfig.brand.logoHeight}
        alt={siteConfig.name}
        loading="eager"
        decoding="async"
      />
    </a>
    {showNavigation && (
      <nav aria-label="Principal">
        <ul class="site-header__nav-list">
          <li>
            <a href="/">Inicio</a>
          </li>
          {siteConfig.navigation.slice(1).map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    background: var(--color-background);
  }

  .site-header__inner {
    display: flex;
    min-height: var(--size-header);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-3);
  }

  .site-header__logo-link {
    flex-shrink: 0;
  }

  .site-header__logo {
    display: block;
    width: auto;
    height: 2rem;
  }

  .site-header__nav-list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    list-style: none;
  }

  .site-header__nav-list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    list-style: none;
  }

  .site-header--sticky {
    position: sticky;
    top: 0;
    z-index: 30;
    box-shadow: var(--shadow-4);
  }
</style>
