---
import { siteConfig } from '../../config/client-config';

interface Props {
  showNavigation?: boolean;
}
const { showNavigation = true } = Astro.props;
---

<header class="site-header wire">
  <div class="site-header__wrapper wrapper wire">
    <a class="site-header__logo-link" href="/">
      <img
        class="site-header__logo"
        src={siteConfig.brand.logo}
        width={siteConfig.brand.logoWidth}
        height={siteConfig.brand.logoHeight}
        alt={siteConfig.name}
        loading="eager"
        decoding="async"
      />
    </a>
    {showNavigation && (
      <nav aria-label="Principal">
        <ul class="site-header__nav-list">
          <li>
            <a href="/">Inicio</a>
          </li>
          {siteConfig.navigation.slice(1).map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    min-height: var(--spacing-8);
    padding-block: var(--spacing-2);
    border-bottom: 1px solid color-mix(in srgb, var(--color-text-default) 10%, transparent);
    background: var(--color-surface-default);
  }

  .site-header__logo-link {
    flex-shrink: 0;
  }

  .site-header__logo {
    display: block;
    width: auto;
    height: 2rem;
  }

  .site-header__nav-list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--spacing-3);
    margin: 0;
    padding: 0;
    font-size: var(--font-size-sm);
    list-style: none;
  }

  .site-header__nav-list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--spacing-3);
    margin: 0;
    padding: 0;
    font-size: var(--font-size-sm);
    list-style: none;
  }

  .site-header--sticky {
    position: sticky;
    top: 0;
    z-index: 30;
  }
</style>
