---
import { siteConfig } from '../../config/site.config';

interface Props {
  showNavigation?: boolean;
}
const { showNavigation = true } = Astro.props;
---

<header class="site-header border-b border-role-foreground/10 bg-role-background">
  <div class="site-header__inner wrapper flex items-center justify-between gap-6 py-3">
    <a class="shrink-0" href="/">
      <img
        class="h-8 w-auto"
        src={siteConfig.brand.logo}
        width={siteConfig.brand.logoWidth}
        height={siteConfig.brand.logoHeight}
        alt={siteConfig.name}
        loading="eager"
        decoding="async"
      />
    </a>
    {showNavigation && (
      <nav aria-label="Principal">
        <ul class="flex list-none items-center gap-5 p-0 text-sm">
          <li>
            <a href="/">Inicio</a>
          </li>
          {siteConfig.navigation.slice(1).map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</header>
