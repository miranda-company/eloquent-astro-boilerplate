---
import { siteConfig } from '../../config/client-config';
---

<header class="site-header">
  <div class="site-header__wrapper wrapper">
    <a class="site-header__logo-link" href="/">
      <img
        class="site-header__logo"
        src={siteConfig.brand.logo}
        width={siteConfig.brand.logoWidth}
        height={siteConfig.brand.logoHeight}
        alt={siteConfig.name}
        loading="eager"
        decoding="async"
      />
    </a>
  </div>
</header>

<style>
  .site-header {
    display: grid;
    align-items: center;
    position: relative;
    z-index: 20;
    min-height: var(--size-8);
    padding-block: var(--spacing-sm);
    border-bottom: var(--border-size-sm) solid var(--color-border-secondary);
    background: var(--color-surface-default);
  }

  .site-header__wrapper {
    display: flex;
    align-items: center;
  }

  .site-header__logo-link {
    flex-shrink: 0;
  }

  .site-header__logo {
    display: block;
    width: auto;
    height: var(--size-4);
  }

  .site-header--sticky {
    position: sticky;
    top: 0;
    z-index: 30;
    animation: site-header-enter 160ms ease;
  }

  @keyframes site-header-enter {
    from {
      opacity: 0;
      transform: translateY(calc(var(--size-2) * -1));
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header--sticky {
      animation: none;
    }
  }
</style>
