---
import {
  resolveSemanticColors,
  type SemanticColorToken,
  siteConfig,
} from '../../config/site.config';

const typeTokens = [
  { name: 'Extra small', size: 'xs', value: '0.75rem / 12px' },
  { name: 'Small', size: 'sm', value: '0.875rem / 14px' },
  { name: 'Base', size: 'base', value: '1rem / 16px' },
  { name: 'Large', size: 'lg', value: '1.125rem / 18px' },
  { name: 'Extra large', size: 'xl', value: '1.25rem / 20px' },
  { name: '2X large', size: '2xl', value: '1.5rem / 24px' },
  { name: '3X large', size: '3xl', value: '1.875rem / 30px' },
  { name: '4X large', size: '4xl', value: '2.25rem / 36px' },
  { name: '5X large', size: '5xl', value: '3rem / 48px' },
  { name: '6X large', size: '6xl', value: '3.75rem / 60px' },
  { name: '7X large', size: '7xl', value: '4.5rem / 72px' },
  { name: '8X large', size: '8xl', value: '6rem / 96px' },
  { name: '9X large', size: '9xl', value: '8rem / 128px' },
];
const semanticColors = resolveSemanticColors(siteConfig.colors);
const paletteGroups = Object.entries(siteConfig.colors.palettes);
const semanticColorMappings = Object.entries(semanticColors).map(([name, value]) => {
  const token = name as SemanticColorToken;
  return {
    name: token,
    reference: siteConfig.colors.semantic[token]!,
    value,
    variable: `--color-${token}`,
  };
});
const spacingTokens = [
  'space-1',
  'space-2',
  'space-3',
  'space-4',
  'space-6',
  'space-8',
  'space-12',
  'space-16',
  'space-24',
] as const;
const sizeTokens = [
  'size-icon',
  'size-control',
  'size-header',
  'radius-md',
  'wrapper-max',
  'wrapper-gutter-mobile',
  'wrapper-gutter-tablet',
  'wrapper-gutter-desktop',
] as const;
const shapeTokens = [
  { token: 'radius-none', name: 'None', use: 'Data tables and square media' },
  { token: 'radius-xs', name: 'Extra small', use: 'Inputs, menus, and compact containers' },
  { token: 'radius-sm', name: 'Small', use: 'Chips and small controls' },
  { token: 'radius-md', name: 'Medium', use: 'Cards and standard surfaces' },
  { token: 'radius-lg', name: 'Large', use: 'Prominent actions and drawers' },
  { token: 'radius-xl', name: 'Extra large', use: 'Feature panels and large surfaces' },
  { token: 'radius-full', name: 'Full', use: 'Pills, avatars, and circular controls' },
] as const;
const breakpointTokens = [
  {
    name: 'Compact',
    range: '< 600px',
    mediaQuery: 'Base styles',
    use: 'Single-column and touch-first layout',
  },
  {
    name: 'Medium',
    range: '600px – 839px',
    mediaQuery: '@media (min-width: 37.5rem)',
    use: 'Room for denser controls or a second column',
  },
  {
    name: 'Expanded',
    range: '840px – 1199px',
    mediaQuery: '@media (min-width: 52.5rem)',
    use: 'Multi-column content and more generous spacing',
  },
  {
    name: 'Large',
    range: '1200px – 1599px',
    mediaQuery: '@media (min-width: 75rem)',
    use: 'Wide desktop layouts and supporting content',
  },
  {
    name: 'Extra large',
    range: '≥ 1600px',
    mediaQuery: '@media (min-width: 100rem)',
    use: 'Large desktop canvases; preserve readable line lengths',
  },
] as const;
const elevationTokens = [
  { token: 'shadow-0', level: '0dp', use: 'Base content and outlined surfaces' },
  { token: 'shadow-1', level: '1dp', use: 'Resting cards and low-priority containers' },
  { token: 'shadow-2', level: '2dp', use: 'Raised controls and selected surfaces' },
  { token: 'shadow-3', level: '3dp', use: 'Lifted card state' },
  { token: 'shadow-4', level: '4dp', use: 'Hovered interactive cards' },
  { token: 'shadow-6', level: '6dp', use: 'Floating action or temporary focus' },
  { token: 'shadow-8', level: '8dp', use: 'Menus and popovers' },
  { token: 'shadow-12', level: '12dp', use: 'Prominent floating actions' },
  { token: 'shadow-16', level: '16dp', use: 'Navigation drawers and side sheets' },
  { token: 'shadow-24', level: '24dp', use: 'Modal dialogs and highest emphasis' },
] as const;
const brandElements = [
  { name: 'Brand logo', path: siteConfig.brand.logo, previewClass: 'logo' },
  { name: 'Brand icon', path: siteConfig.brand.icon, previewClass: 'icon' },
];
---

<section class="section design-system-preview__section design-system-preview__section--intro">
  <div class="wrapper">
    <p class="design-system-preview__eyebrow">Internal reference</p>
    <h1 class="design-system-preview__title">Design system</h1>
    <p class="design-system-preview__lead">
      A living preview of the client theme, typography, primitives, and interaction states. This
      boilerplate page is intentionally excluded from search indexes.
    </p>
  </div>
</section>

<section class="section design-system-preview__section design-system-preview__section--surface">
  <div class="wrapper">
    <h2 class="design-system-preview__section-title">Brand elements</h2>
    <p class="design-system-preview__description">
      Logo and icon assets are configured once, then previewed as monochrome SVG masks without
      exporting duplicate light and dark files.
    </p>
    <div class="design-system-preview__grid design-system-preview__grid--brand">
      {brandElements.map((element) => (
        <article class="design-system-preview__card">
          <div class="design-system-preview__card-header">
            <h3 class="design-system-preview__card-title">{element.name}</h3>
            <code class="design-system-preview__code design-system-preview__code--path">
              {element.path}
            </code>
          </div>
          <div class="design-system-preview__brand-swatches">
            <div class="brand__preview--light design-system-preview__brand-stage">
              <span
                aria-hidden="true"
                class:list={[
                  'brand__mark brand__mark--black',
                  `design-system-preview__brand-mark design-system-preview__brand-mark--${element.previewClass}`,
                ]}
                style={`--brand-asset: url('${element.path}')`}
              ></span>
            </div>
            <div class="brand__preview--dark design-system-preview__brand-stage">
              <span
                aria-hidden="true"
                class:list={[
                  'brand__mark brand__mark--white',
                  `design-system-preview__brand-mark design-system-preview__brand-mark--${element.previewClass}`,
                ]}
                style={`--brand-asset: url('${element.path}')`}
              ></span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section design-system-preview__section design-system-preview__section--surface">
  <div class="wrapper">
    <h2 class="design-system-preview__section-title">Typography</h2>
    <p class="design-system-preview__description">
      The full type scale uses the configured system-font token and can be replaced per client.
    </p>
    <div class="design-system-preview__font-card">
      <p class="design-system-preview__card-title">Font family</p>
      <p class="design-system-preview__code design-system-preview__code--font">
        --font-sans: {siteConfig.theme['font-sans']}
      </p>
    </div>
    <div class="design-system-preview__type-list">
      {typeTokens.map(({ name, size, value }) => (
        <div class="design-system-preview__type-row">
          <span
            class:list={[
              'design-system-preview__type-sample',
              `design-system-preview__type-sample--${size}`,
            ]}
          >
            Aa
          </span>
          <span class="design-system-preview__code design-system-preview__code--type">
            {name} · {value}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section design-system-preview__section">
  <div class="wrapper">
    <h2 class="design-system-preview__section-title">Colors</h2>
    <p class="design-system-preview__description">
      Raw client palettes remain available for design work. Components consume the semantic roles
      below, so a rebrand changes mappings rather than component markup.
    </p>
    <div class="design-system-preview__grid design-system-preview__grid--palette">
      {paletteGroups.map(([palette, shades]) => (
        <article class="design-system-preview__card">
          <h3 class="design-system-preview__palette-title">{palette}</h3>
          <ul class="design-system-preview__palette-list">
            {Object.entries(shades).map(([shade, value]) => (
              <li class="design-system-preview__palette-row">
                <span
                  aria-hidden="true"
                  class="design-system-preview__swatch"
                  style={`background: ${value}`}
                ></span>
                <code class="design-system-preview__code design-system-preview__code--muted">
                  --palette-{palette}-{shade}
                </code>
                <code class="design-system-preview__code design-system-preview__code--strong">
                  {value}
                </code>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <h3 class="design-system-preview__subheading">Semantic roles</h3>
    <p class="design-system-preview__subdescription">
      Components consume semantic CSS custom properties such as <code>--color-primary</code>.
    </p>
    <dl class="design-system-preview__grid design-system-preview__grid--semantic design-system-preview__semantic-grid">
      {semanticColorMappings.map((token) => (
        <div class="design-system-preview__semantic-card">
          <dt class="design-system-preview__semantic-term">
            <span
              aria-hidden="true"
              class="design-system-preview__swatch"
              style={`background: ${token.value}`}
            ></span>
            <span class="design-system-preview__code design-system-preview__code--muted design-system-preview__code--path">
              <code>{token.variable}</code>
            </span>
          </dt>
          <dd class="design-system-preview__semantic-description">
            {token.reference.palette}.{token.reference.shade} → {token.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="section design-system-preview__section design-system-preview__section--muted">
  <div class="wrapper">
    <h2 class="design-system-preview__section-title">Spacing and size tokens</h2>
    <div class="design-system-preview__grid design-system-preview__grid--spacing design-system-preview__spacing-grid">
      <div class="design-system-preview__token-group">
        <h3 class="design-system-preview__subheading design-system-preview__subheading--flush">
          Spacing
        </h3>
        <div class="design-system-preview__token-list">
          {spacingTokens.map((token) => (
            <div class="design-system-preview__spacing-row">
              <span class="design-system-preview__code design-system-preview__code--muted">
                --{token} · {siteConfig.theme[token]}
              </span>
              <div
                class="design-system-preview__spacing-sample"
                style={`width: var(--${token})`}
              ></div>
            </div>
          ))}
        </div>
      </div>
      <div class="design-system-preview__token-group">
        <h3 class="design-system-preview__subheading design-system-preview__subheading--flush">
          Sizes
        </h3>
        <div class="design-system-preview__size-list">
          {sizeTokens.map((token) => (
            <div class="design-system-preview__size-card">
              <span class="design-system-preview__code design-system-preview__code--muted">
                --{token} · {siteConfig.theme[token]}
              </span>
              <div
                class="design-system-preview__size-sample"
                style={
                  token === 'radius-md'
                    ? `height: var(--size-control); width: var(--size-control); border-radius: var(--${token})`
                    : token === 'wrapper-max'
                      ? `height: var(--space-4); width: min(100%, var(--${token}))`
                      : `height: var(--${token}); width: var(--${token})`
                }
              ></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section design-system-preview__section">
  <div class="wrapper">
    <h2 class="design-system-preview__section-title">Buttons</h2>
    <div class="design-system-preview__button-row">
      <a class="button button--primary" href="#components">
        Primary action
      </a>
      <a class="button button--secondary" href="#components">
        Secondary action
      </a>
      <button class="button button--muted" disabled type="button">
        Disabled
      </button>
    </div>
  </div>
</section>

<section
  id="components"
  class="section design-system-preview__section design-system-preview__section--surface"
>
  <div class="wrapper design-system-preview__grid design-system-preview__grid--components design-system-preview__components-grid">
    <div>
      <h2 class="design-system-preview__section-title">Cards and other components</h2>
      <article class="design-system-preview__component-card">
        <p class="design-system-preview__eyebrow">Card label</p>
        <h3 class="design-system-preview__card-heading">Reusable card</h3>
        <p class="design-system-preview__card-description">
          Surface, spacing, border, and elevation all come from the shared token system.
        </p>
      </article>
    </div>
    <div class="design-system-preview__form-example">
      <label class="design-system-preview__form-label" for="preview-name">
        Form label
      </label>
      <input
        class="design-system-preview__form-control"
        id="preview-name"
        placeholder="Input placeholder"
      />
      <p class="design-system-preview__error">Example validation message</p>
    </div>
  </div>
</section>

<section class="section design-system-preview__section">
  <div class="wrapper">
    <h2 class="design-system-preview__section-title">Elevation</h2>
    <p class="design-system-preview__description">
      A two-layer shadow scale separates resting surfaces from temporary, high-priority UI. The
      labels follow familiar Material elevation steps; the CSS values are tuned per client theme.
    </p>
    <div class="design-system-preview__grid design-system-preview__grid--elevation">
      {elevationTokens.map((elevation) => (
        <article class="design-system-preview__elevation-card">
          <div
            class="design-system-preview__elevation-surface"
            style={`box-shadow: var(--${elevation.token})`}
          >
            <p class="design-system-preview__card-title">Elevation {elevation.level}</p>
          </div>
          <div class="design-system-preview__elevation-details">
            <p class="design-system-preview__small-copy">{elevation.use}</p>
            <code class="design-system-preview__code design-system-preview__code--strong">
              --{elevation.token}
            </code>
            <code class="design-system-preview__code design-system-preview__code--muted">
              {siteConfig.theme[elevation.token]}
            </code>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section design-system-preview__section">
  <div class="wrapper">
    <h2 class="design-system-preview__section-title">Shape and border radius</h2>
    <p class="design-system-preview__description">
      The scale moves from square to fully rounded. It follows the Material 3 shape vocabulary,
      while every value remains a client-configurable CSS token.
    </p>
    <div class="design-system-preview__grid design-system-preview__grid--shape">
      {shapeTokens.map((shape) => (
        <article class="design-system-preview__shape-card">
          <div
            class="design-system-preview__shape-stage"
            style={`border-radius: var(--${shape.token})`}
          >
            <span
              class="design-system-preview__shape-swatch"
              style={`border-radius: var(--${shape.token})`}
            ></span>
          </div>
          <div class="design-system-preview__shape-details">
            <p class="design-system-preview__card-title">{shape.name}</p>
            <p class="design-system-preview__small-copy">{shape.use}</p>
            <code class="design-system-preview__code design-system-preview__code--strong">
              --{shape.token}
            </code>
            <code class="design-system-preview__code design-system-preview__code--muted">
              {siteConfig.theme[shape.token]}
            </code>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section design-system-preview__section design-system-preview__section--surface">
  <div class="wrapper">
    <h2 class="design-system-preview__section-title">Breakpoints</h2>
    <p class="design-system-preview__description">
      Layout is mobile-first. These viewport ranges are Material-inspired size classes mapped to
      authored CSS media queries used by this starter.
    </p>
    <div class="design-system-preview__grid design-system-preview__grid--breakpoints design-system-preview__breakpoint-grid">
      {breakpointTokens.map((breakpoint) => (
        <article class="design-system-preview__breakpoint-card">
          <p class="design-system-preview__card-title">{breakpoint.name}</p>
          <p class="design-system-preview__breakpoint-range">{breakpoint.range}</p>
          <code class="design-system-preview__code design-system-preview__code--strong">
            {breakpoint.mediaQuery}
          </code>
          <p class="design-system-preview__small-copy">{breakpoint.use}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .design-system-preview__title {
    display: block;
  }

  .design-system-preview__description {
    max-width: 42rem;
    margin: var(--space-3) 0 0;
    color: color-mix(in srgb, var(--color-foreground) 75%, transparent);
  }

  .design-system-preview__section-title {
    line-height: 1.2;
  }

  .design-system-preview__grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .design-system-preview__card,
  .design-system-preview__font-card,
  .design-system-preview__semantic-card,
  .design-system-preview__size-card,
  .design-system-preview__component-card,
  .design-system-preview__elevation-card,
  .design-system-preview__shape-card,
  .design-system-preview__breakpoint-card {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: var(--radius-md);
    background: var(--color-background);
    box-shadow: var(--shadow-1);
  }

  .design-system-preview__card-header {
    padding: var(--space-4) 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  .design-system-preview__card-title {
    margin: 0;
    font-weight: 600;
  }

  .design-system-preview__card-heading {
    margin: var(--space-2) 0 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .design-system-preview__code {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .design-system-preview__code--muted {
    color: color-mix(in srgb, var(--color-foreground) 75%, transparent);
  }

  .design-system-preview__code--strong {
    font-weight: 600;
  }

  .design-system-preview__code--path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .design-system-preview__code--font {
    margin-top: var(--space-2);
  }

  .design-system-preview__code--type {
    flex-shrink: 0;
  }

  .design-system-preview__brand-swatches {
    display: grid;
  }

  .design-system-preview__brand-stage {
    display: flex;
    min-height: 9rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-8);
  }

  .design-system-preview__brand-mark--logo {
    width: 100%;
    height: 4rem;
  }

  .design-system-preview__brand-mark--icon {
    width: 4rem;
    height: 4rem;
  }

  .design-system-preview__font-card {
    margin-top: var(--space-6);
    padding: var(--space-4);
  }

  .design-system-preview__type-list {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: var(--radius-md);
  }

  .design-system-preview__type-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  .design-system-preview__type-row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .design-system-preview__type-sample {
    overflow: hidden;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .design-system-preview__type-sample--xs {
    font-size: 0.75rem;
  }
  .design-system-preview__type-sample--sm {
    font-size: 0.875rem;
  }
  .design-system-preview__type-sample--base {
    font-size: 1rem;
  }
  .design-system-preview__type-sample--lg {
    font-size: 1.125rem;
  }
  .design-system-preview__type-sample--xl {
    font-size: 1.25rem;
  }
  .design-system-preview__type-sample--2xl {
    font-size: 1.5rem;
  }
  .design-system-preview__type-sample--3xl {
    font-size: 1.875rem;
  }
  .design-system-preview__type-sample--4xl {
    font-size: 2.25rem;
  }
  .design-system-preview__type-sample--5xl {
    font-size: 3rem;
  }
  .design-system-preview__type-sample--6xl {
    font-size: 3.75rem;
  }
  .design-system-preview__type-sample--7xl {
    font-size: 4.5rem;
  }
  .design-system-preview__type-sample--8xl {
    font-size: 6rem;
  }
  .design-system-preview__type-sample--9xl {
    font-size: 8rem;
  }

  .design-system-preview__palette-title {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    font-size: 1.125rem;
    font-weight: 600;
    text-transform: capitalize;
  }

  .design-system-preview__palette-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .design-system-preview__palette-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: 0.625rem var(--space-4);
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  .design-system-preview__palette-row:last-child {
    border-bottom: 0;
  }

  .design-system-preview__swatch {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 15%, transparent);
    border-radius: var(--radius-sm);
  }

  .design-system-preview__subheading {
    margin: var(--space-12) 0 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .design-system-preview__subheading--flush {
    margin-top: 0;
  }

  .design-system-preview__subdescription {
    margin: var(--space-2) 0 0;
    color: color-mix(in srgb, var(--color-foreground) 75%, transparent);
  }

  .design-system-preview__semantic-grid {
    gap: var(--space-4);
    margin-top: 1.25rem;
  }

  .design-system-preview__semantic-card {
    padding: var(--space-4);
    background: var(--color-surface);
    box-shadow: none;
  }

  .design-system-preview__semantic-term {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
  }

  .design-system-preview__semantic-description {
    margin: var(--space-2) 0 0;
