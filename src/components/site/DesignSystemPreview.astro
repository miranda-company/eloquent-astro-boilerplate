---
import { getFigmaTokenCollections, getFigmaTokenCssName } from '../../config/figma-tokens-adapter';

const tokenCollections = getFigmaTokenCollections();
const fontTokens = tokenCollections.find(({ name }) => name === 'Font tokens');
const colorTokens = tokenCollections.find(({ name }) => name === 'Color tokens');
const primitiveTokenCollection = tokenCollections.find(({ name }) => name === 'Primitives');
const spacingTokenCollection = tokenCollections.find(({ name }) => name === 'Spacing tokens');
const globalSizeTokenCollection = tokenCollections.find(
  ({ name }) => name === 'Global size tokens',
);
const fontSizeTokens =
  fontTokens?.variables.filter(({ name }) => name.startsWith('font-size-')) ?? [];
const semanticColorTokens = colorTokens?.variables ?? [];
const primitiveColorTokens =
  primitiveTokenCollection?.variables.filter(
    ({ name }) => name.startsWith('color-neutral-') || name.startsWith('color-palette-'),
  ) ?? [];
const spacingTokens = spacingTokenCollection?.variables ?? [];
const globalSizeTokens = globalSizeTokenCollection?.variables ?? [];
const maxGlobalWidth = Math.max(
  ...globalSizeTokens
    .filter(({ name }) => name.startsWith('max-width-'))
    .flatMap(({ modes }) => Object.values(modes))
    .filter((value): value is number => typeof value === 'number'),
);

if (fontSizeTokens.length === 0) throw new Error('Missing Figma font-size tokens for preview');
if (semanticColorTokens.length === 0)
  throw new Error('Missing Figma semantic color tokens for preview');
if (primitiveColorTokens.length === 0)
  throw new Error('Missing Figma primitive color tokens for preview');
if (spacingTokens.length === 0) throw new Error('Missing Figma spacing tokens for preview');
if (globalSizeTokens.length === 0 || !Number.isFinite(maxGlobalWidth))
  throw new Error('Missing Figma global size tokens for preview');

function formatValue(value: string | number, type: string, name: string): string {
  if (typeof value !== 'number') return value;
  return type === 'FLOAT' && !name.startsWith('font-weight-') ? `${value}px` : String(value);
}
---

<section class="design-system-preview__intro section" aria-labelledby="design-system-preview-title">
  <div class="design-system-preview__wrapper wrapper stack">
    <h1 class="design-system-preview__title" id="design-system-preview-title">
      Design System
    </h1>
    <p class="design-system-preview__description">This is the design system of eloquent.</p>
  </div>
</section>

<section class="ds-tokens section" aria-labelledby="ds-tokens-title">
  <div class="ds-tokens__wrapper wrapper stack">
    <h2 class="ds-tokens__title" id="ds-tokens-title">
      Tokens
    </h2>
    <p class="ds-tokens__description">
      This are the variables from the figma file and their corresponding css classes.
    </p>
    <h3 class="ds-tokens__group-title">Font sizes</h3>
    <div class="ds-tokens__font-sizes-grid">
      {fontSizeTokens.map((token) => (
        <div class="ds-tokens__card stack">
          <p class="ds-tokens__css-name">
            <code>{getFigmaTokenCssName(token.name)}</code>
          </p>
          <div class="ds-tokens__details">
            <p class="ds-tokens__figma-name">
              Figma name:
              <code> {token.name}</code>
            </p>
            <ul class="ds-tokens__values">
              {Object.entries(token.modes).map(([mode, value]) => (
                <li class="ds-tokens__value">
                  <span>{mode}:</span> <code>{formatValue(value, token.type, token.name)}</code>
                </li>
              ))}
            </ul>
          </div>
          <div class="ds-tokens__samples">
            {Object.entries(token.modes).map(([mode, value]) => (
              <div class="ds-tokens__sample">
                <span class="ds-tokens__sample-mode">{mode}</span>
                <p
                  class="ds-tokens__sample-text"
                  style={`font-size: ${formatValue(value, token.type, token.name)}`}
                >
                  Aa
                </p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <h3 class="ds-tokens__group-title">Semantic colors</h3>
    <div class="ds-tokens__semantic-colors-grid">
      {semanticColorTokens.map((token) => (
        <div class="ds-tokens__card stack">
          <p class="ds-tokens__css-name">
            <code>{getFigmaTokenCssName(token.name)}</code>
          </p>
          <div class="ds-tokens__details">
            <p class="ds-tokens__figma-name">
              Figma name:
              <code> {token.name}</code>
            </p>
            <ul class="ds-tokens__values">
              {Object.entries(token.modes).map(([mode, value]) => (
                <li class="ds-tokens__value">
                  <span>{mode}:</span> <code>{formatValue(value, token.type, token.name)}</code>
                </li>
              ))}
            </ul>
          </div>
          <div class="ds-tokens__color-examples">
            {Object.entries(token.modes).map(([mode, value]) => (
              <div class="ds-tokens__color-example">
                <span class="ds-tokens__color-mode">{mode}</span>
                <div
                  class="ds-tokens__color-sample"
                  style={`background-color: ${value}`}
                  aria-hidden="true"
                ></div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <h3 class="ds-tokens__group-title">Primitive colors</h3>
    <div class="ds-tokens__primitive-colors-grid">
      {primitiveColorTokens.map((token) => (
        <div class="ds-tokens__card stack">
          <p class="ds-tokens__css-name">
            <code>{getFigmaTokenCssName(token.name)}</code>
          </p>
          <div class="ds-tokens__details">
            <p class="ds-tokens__figma-name">
              Figma name:
              <code> {token.name}</code>
            </p>
            <ul class="ds-tokens__values">
              {Object.entries(token.modes).map(([mode, value]) => (
                <li class="ds-tokens__value">
                  <span>{mode}:</span> <code>{formatValue(value, token.type, token.name)}</code>
                </li>
              ))}
            </ul>
          </div>
          <div
            class="ds-tokens__primitive-color-swatch"
            style={`background-color: ${Object.values(token.modes)[0]}`}
            aria-hidden="true"
          ></div>
        </div>
      ))}
    </div>
    <h3 class="ds-tokens__group-title">Spacing</h3>
    <div class="ds-tokens__spacing-grid">
      {spacingTokens.map((token) => (
        <div class="ds-tokens__card stack">
          <p class="ds-tokens__css-name">
            <code>{getFigmaTokenCssName(token.name)}</code>
          </p>
          <div class="ds-tokens__details">
            <p class="ds-tokens__figma-name">
              Figma name:
              <code> {token.name}</code>
            </p>
            <ul class="ds-tokens__values">
              {Object.entries(token.modes).map(([mode, value]) => (
                <li class="ds-tokens__value">
                  <span>{mode}:</span> <code>{formatValue(value, token.type, token.name)}</code>
                </li>
              ))}
            </ul>
          </div>
          <div class="ds-tokens__spacing-examples">
            {Object.entries(token.modes).map(([mode, value]) => (
              <div class="ds-tokens__spacing-example">
                <span class="ds-tokens__spacing-mode">{mode}</span>
                <div class="ds-tokens__spacing-track" aria-hidden="true">
                  <div
                    class="ds-tokens__spacing-sample"
                    style={`width: ${formatValue(value, token.type, token.name)}`}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <h3 class="ds-tokens__group-title">Global size tokens</h3>
    <div class="ds-tokens__global-size-grid">
      {globalSizeTokens.map((token) => (
        <div class="ds-tokens__card stack">
          <p class="ds-tokens__css-name">
            <code>{getFigmaTokenCssName(token.name)}</code>
          </p>
          <div class="ds-tokens__details">
            <p class="ds-tokens__figma-name">
              Figma name:
              <code> {token.name}</code>
            </p>
            <ul class="ds-tokens__values">
              {Object.entries(token.modes).map(([mode, value]) => (
                <li class="ds-tokens__value">
                  <span>{mode}:</span> <code>{formatValue(value, token.type, token.name)}</code>
                </li>
              ))}
            </ul>
          </div>
          <div class="ds-tokens__global-size-examples">
            {Object.entries(token.modes).map(([mode, value]) => (
              <div class="ds-tokens__global-size-example">
                <span class="ds-tokens__global-size-mode">{mode}</span>
                <div class="ds-tokens__global-size-track" aria-hidden="true">
                  <div
                    class:list={[
                      'ds-tokens__global-size-sample',
                      token.name.startsWith('max-width-')
                        ? 'ds-tokens__global-size-sample--max-width'
                        : token.name === 'wire-size'
                          ? 'ds-tokens__global-size-sample--wire-size'
                          : 'ds-tokens__global-size-sample--border-size',
                    ]}
                    style={
                      token.name.startsWith('max-width-') && typeof value === 'number'
                        ? `width: ${((value / maxGlobalWidth) * 100).toFixed(2)}%`
                        : `width: 100%; height: ${formatValue(value, token.type, token.name)}`
                    }
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ds-tokens__font-sizes-grid,
  .ds-tokens__semantic-colors-grid,
  .ds-tokens__primitive-colors-grid,
  .ds-tokens__spacing-grid,
  .ds-tokens__global-size-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  .ds-tokens__group-title {
    margin-top: var(--spacing-xl);
  }

  .ds-tokens__group-description {
    color: var(--color-text-secondary);
  }

  .ds-tokens__card {
    padding: var(--spacing-md);
    border: var(--border-size-sm) solid var(--color-border-secondary);
    border-radius: var(--radius-md);
    background: var(--color-surface-default);
  }

  .ds-tokens__css-name {
    margin: 0;
    font-size: var(--font-size-md);
    line-height: var(--font-leading-lg);
  }

  .ds-tokens__figma-name {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  .ds-tokens__values {
    display: grid;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  .ds-tokens__value {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  .ds-tokens__samples {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-sm);
  }

  .ds-tokens__sample {
    display: grid;
    gap: var(--spacing-xs);
  }

  .ds-tokens__sample-mode {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  .ds-tokens__sample-text {
    margin: 0;
    color: var(--color-text-default);
    line-height: 1.2;
  }

  .ds-tokens__color-examples {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-sm);
  }

  .ds-tokens__color-example {
    display: grid;
    gap: var(--spacing-xs);
  }

  .ds-tokens__color-mode {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  .ds-tokens__color-sample {
    min-height: var(--spacing-5);
    border: var(--border-size-sm) solid var(--color-border-secondary);
    border-radius: var(--radius-sm);
  }

  .ds-tokens__primitive-color-swatch {
    min-height: var(--spacing-5);
    border: var(--border-size-sm) solid var(--color-border-secondary);
    border-radius: var(--radius-sm);
  }

  .ds-tokens__spacing-examples {
    display: grid;
    gap: var(--spacing-sm);
  }

  .ds-tokens__spacing-example {
    display: grid;
    gap: var(--spacing-xs);
  }

  .ds-tokens__spacing-mode {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  .ds-tokens__spacing-track {
    width: 15rem;
    max-width: 100%;
    min-height: var(--spacing-1);
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-surface-secondary);
  }

  .ds-tokens__spacing-sample {
    min-height: var(--spacing-1);
    border-radius: var(--radius-sm);
    background: var(--color-surface-brand);
  }

  .ds-tokens__global-size-examples {
    display: grid;
    gap: var(--spacing-sm);
  }

  .ds-tokens__global-size-example {
    display: grid;
    gap: var(--spacing-xs);
  }

  .ds-tokens__global-size-mode {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  .ds-tokens__global-size-track {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: var(--spacing-1);
    border-radius: var(--radius-sm);
    background: var(--color-surface-secondary);
  }

  .ds-tokens__global-size-sample {
    border-radius: var(--radius-sm);
    background: var(--color-surface-brand);
  }

  .ds-tokens__global-size-sample--max-width {
    height: var(--spacing-1);
  }

  .ds-tokens__global-size-sample--wire-size {
    width: 100%;
  }

  .ds-tokens__global-size-sample--border-size {
    width: 100%;
  }
</style>
