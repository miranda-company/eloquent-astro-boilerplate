---
import { siteConfig } from '../../config/site.config';
---

<footer class="site-footer">
  <div class="site-footer__inner wrapper">
    <address class="site-footer__contact">
      <p class="site-footer__name">{siteConfig.name}</p>
      <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
    </address>
    <div class="site-footer__links">
      <nav aria-label={siteConfig.legal.navigationLabel}>
        <ul class="site-footer__legal-list">
          {siteConfig.legal.pages.map((page) => (
            <li>
              <a href={page.href}>{page.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      {siteConfig.features.consentBanner && (
        <button class="site-footer__consent-button" type="button" data-open-consent>
          Gestionar cookies
        </button>
      )}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    background: var(--color-surface);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
    padding-block: 2.5rem;
    font-size: 0.875rem;
  }

  .site-footer__contact {
    font-style: normal;
  }

  .site-footer__name {
    margin: 0;
    font-weight: 600;
  }

  .site-footer__contact p {
    margin: 0;
    font-weight: 600;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }

  .site-footer__legal-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__consent-button {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-decoration: underline;
  }

  @media (min-width: 52.5rem) {
    .site-footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__links {
      justify-content: flex-end;
    }
  }
</style>
