---
import { siteConfig } from '../../config/site.config';
---

<footer class="border-t border-role-foreground/10 bg-role-surface">
  <div class="wrapper grid gap-6 py-10 text-sm md:grid-cols-2">
    <address class="not-italic">
      <p class="font-semibold">{siteConfig.name}</p>
      <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
    </address>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 md:justify-end">
      <nav aria-label={siteConfig.legal.navigationLabel}>
        <ul class="flex list-none flex-wrap gap-x-3 gap-y-1 p-0">
          {siteConfig.legal.pages.map((page) => (
            <li>
              <a href={page.href}>{page.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      {siteConfig.features.consentBanner && (
        <button
          class="cursor-pointer border-0 bg-transparent p-0 underline"
          type="button"
          data-open-consent
        >
          Gestionar cookies
        </button>
      )}
    </div>
  </div>
</footer>
