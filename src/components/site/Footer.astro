---
import { siteConfig } from '../../config/client-config';
---

<footer class="site-footer">
  <div class="wrapper">
    <div class="site-footer__inner">
      <address class="site-footer__contact">
        <p class="site-footer__name">{siteConfig.name}</p>
        <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
      </address>
      <div class="site-footer__links">
        <nav aria-label={siteConfig.legal.navigationLabel}>
          <ul class="site-footer__legal-list">
            {siteConfig.legal.pages.map((page) => (
              <li>
                <a href={page.href}>{page.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        {siteConfig.features.consentBanner && (
          <button class="site-footer__consent-button" type="button" data-open-consent>
            Gestionar cookies
          </button>
        )}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--spacing-5);
    border-top: var(--border-size-sm) solid
      color-mix(in srgb, var(--color-text-default) 10%, transparent);
    background: var(--color-surface-default);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--spacing-3);
    font-size: var(--font-size-sm);
  }

  .site-footer__contact {
    font-style: normal;
  }

  .site-footer__name {
    margin: 0;
    font-weight: var(--font-weight-bold);
  }

  .site-footer__contact p {
    margin: 0;
    font-weight: var(--font-weight-bold);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-0-5) var(--spacing-2);
  }

  .site-footer__legal-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-0-5) var(--spacing-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__consent-button {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__links {
      justify-content: flex-end;
    }
  }
</style>
