---
import { siteConfig } from '../../config/client-config';
import '../../styles/button.css';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
const enabled = siteConfig.features.contactForm && Boolean(endpoint);
---

<section id="contacto" class="section contact-section">
  <div class="wrapper contact-section__content">
    <h2 class="contact-section__title">Hablemos de tu proyecto</h2>
    <p class="contact-section__intro">
      Cuéntanos qué necesitas y te responderemos lo antes posible.
    </p>
    {enabled ? (
      <form class="contact-form" action={endpoint} method="POST" data-contact-form>
        <div>
          <label class="contact-form__label" for="name">
            Nombre
          </label>
          <input class="contact-form__control" id="name" name="name" autocomplete="name" required />
        </div>
        <div>
          <label class="contact-form__label" for="email">
            Email
          </label>
          <input
            class="contact-form__control"
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>
        <div>
          <label class="contact-form__label" for="message">
            Mensaje
          </label>
          <textarea
            class="contact-form__control"
            id="message"
            name="message"
            rows="5"
            required
          ></textarea>
        </div>
        <button class="button button--primary contact-form__submit" type="submit">
          Enviar mensaje
        </button>
        <p
          class="contact-form__status"
          hidden
          data-form-status
          role="status"
          aria-live="polite"
        ></p>
      </form>
    ) : (
      <p class="contact-section__fallback">
        El formulario aún no está configurado. Escríbenos a{' '}
        <a class="contact-section__email" href={`mailto:${siteConfig.contact.email}`}>
          {siteConfig.contact.email}
        </a>
        .
      </p>
    )}
  </div>
</section>
{enabled && <script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) =>
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const button = form.querySelector<HTMLButtonElement>('[type="submit"]');
      if (!status || !button) return;
      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      status.hidden = false;
      status.textContent = 'Enviando…';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error('Submission failed');
        form.reset();
        status.textContent = 'Gracias. Tu mensaje se ha enviado correctamente.';
      } catch {
        status.textContent =
          'No se ha podido enviar el mensaje. Inténtalo de nuevo o escríbenos por email.';
      } finally {
        button.disabled = false;
        form.removeAttribute('aria-busy');
      }
    }),
  );
</script>}

<style>
  .contact-section {
    background: var(--color-surface-secondary);
  }

  .contact-section__content {
    max-width: 42rem;
  }

  .contact-section__title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--font-tracking-tight);
    line-height: var(--font-leading-xl);
  }

  .contact-section__intro {
    margin: var(--spacing-2) 0 0;
  }

  .contact-form {
    display: grid;
    gap: 1.25rem;
    margin-top: var(--spacing-4);
  }

  .contact-form__label {
    display: block;
    margin-bottom: var(--spacing-0-5);
    font-weight: var(--font-weight-regular);
  }

  .contact-form__control {
    display: block;
    width: 100%;
    padding: var(--spacing-1) var(--spacing-2);
    border: 1px solid var(--color-border-secondary);
    border-radius: var(--radius-md);
    background: var(--color-surface-default);
    color: var(--color-text-default);
    font: inherit;
  }

  .contact-form__submit {
    justify-self: start;
  }

  .contact-form__status[hidden] {
    display: none;
  }

  .contact-section__fallback {
    margin-top: var(--spacing-3);
    padding: var(--spacing-2);
    border: 1px solid color-mix(in srgb, var(--color-text-default) 15%, transparent);
    border-radius: var(--radius-md);
    background: var(--color-surface-default);
    font-size: var(--font-size-sm);
  }

  .contact-section__email {
    font-weight: var(--font-weight-regular);
  }
</style>
