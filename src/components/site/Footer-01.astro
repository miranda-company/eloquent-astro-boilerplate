---
import { Mail, MapPin, Phone } from '@lucide/astro';
import { siteConfig } from '../../config/client-config';
import type { SiteLink } from '../../config/client-config';

export type FooterLink = SiteLink;

interface Props {
  title?: string;
  description?: string;
  pages?: FooterLink[];
  socialLinks?: FooterLink[];
  phone?: string;
  address?: string;
  legalEntity?: string;
  showConsentPreferences?: boolean;
}

const {
  title,
  description,
  pages = siteConfig.navigation.footer,
  socialLinks = siteConfig.social,
  phone = siteConfig.contact.phone,
  address = siteConfig.contact.address,
  legalEntity = siteConfig.legal.entityName,
  showConsentPreferences = false,
} = Astro.props;

const contactItems = [
  {
    value: siteConfig.contact.email,
    href: `mailto:${siteConfig.contact.email}`,
    Icon: Mail,
  },
  ...(phone
    ? [
        {
          value: phone,
          href: `tel:${phone.replaceAll(/[^+\d]/g, '')}`,
          Icon: Phone,
        },
      ]
    : []),
  ...(address
    ? [
        {
          value: address,
          Icon: MapPin,
        },
      ]
    : []),
];
---

<footer class="footer-01 section">
  <div class="footer-01__wrapper wrapper">
    <div class="footer-01__identity">
      <a class="footer-01__logo-link" href="/">
        <img
          class="footer-01__logo"
          src={siteConfig.brand.logo}
          width={siteConfig.brand.logoWidth}
          height={siteConfig.brand.logoHeight}
          alt={siteConfig.name}
          loading="eager"
          decoding="async"
        />
      </a>
      <div class="footer-01__main-texts">
        {title && <p class="footer-01__title">{title}</p>}
        {description && <p class="footer-01__description">{description}</p>}
      </div>
    </div>

    <div class="footer-01__content">
      <div class="footer-01__info">
        {pages.length > 0 && (
          <nav class="footer-01__link-group stack-xs" aria-label="Páginas">
            <p class="footer-01__info-label">Páginas</p>
            <ul class="footer-01__link-list stack-xs">
              {pages.map((page) => (
                <li>
                  <a href={page.href}>{page.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {socialLinks.length > 0 && (
          <nav class="footer-01__link-group stack-xs" aria-label="Síguenos">
            <p class="footer-01__info-label">Síguenos</p>
            <ul class="footer-01__link-list stack-xs">
              {socialLinks.map((socialLink) => (
                <li>
                  <a href={socialLink.href}>{socialLink.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <address class="footer-01__contact stack-xs">
          <p class="footer-01__info-label">Contacto</p>
          <ul class="footer-01__contact-list stack-xs">
            {contactItems.map(({ Icon, ...item }) => (
              <li class="footer-01__contact-item">
                <Icon class="footer-01__contact-icon" aria-hidden="true" />
                {item.href ? (
                  <a class="footer-01__contact-value" href={item.href}>
                    {item.value}
                  </a>
                ) : (
                  <span class="footer-01__contact-value">{item.value}</span>
                )}
              </li>
            ))}
          </ul>
        </address>
      </div>
      <div class="footer-01__legal">
        <nav aria-label={siteConfig.legal.navigationLabel}>
          <ul class="footer-01__legal-list">
            {siteConfig.legal.pages.map((page) => (
              <li>
                <a href={page.href}>{page.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        {showConsentPreferences && (
          <button class="footer-01__consent-button" type="button" data-open-consent>
            Gestionar cookies
          </button>
        )}
        <p class="footer-01__copyright">
          © {new Date().getFullYear()} {legalEntity}
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-01 {
    padding-block: var(--spacing-xl);
    background: var(--color-surface-default);
  }

  .footer-01__wrapper {
    display: grid;
    gap: var(--spacing-gutter-default);
  }

  .footer-01__identity,
  .footer-01__content {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: var(--spacing-gutter-default);
    min-width: 0;
    padding-bottom: var(--spacing-lg);
  }

  .footer-01__main-texts {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .footer-01__logo-link {
    width: 128px;
  }

  .footer-01__logo {
    width: 100%;
    height: auto;
  }

  .footer-01__title {
    color: var(--color-text-secondary);
    font-family: var(--font-family-title), sans-serif;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--font-leading-xl);
  }

  .footer-01__description {
    color: var(--color-text-default);
    font-size: var(--font-size-md);
    line-height: var(--font-leading-lg);
  }

  .footer-01__info {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-gutter-default);
    border-top: var(--border-size-sm) solid var(--color-border-default);
    padding: var(--spacing-lg) 0;
  }

  .footer-01__contact {
    min-width: 0;
    font-style: normal;
  }

  .footer-01__info-label {
    font-size: var(--font-size-lg);
    line-height: var(--font-leading-xl);
  }

  .footer-01__link-list,
  .footer-01__contact-list {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--font-leading-lg);
  }

  .footer-01__contact-list {
    color: var(--color-text-default);
  }

  .footer-01__contact-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-xxs);
  }

  .footer-01__contact-icon {
    width: var(--size-icon-md);
    height: var(--size-icon-md);
    flex: 0 0 auto;
  }

  .footer-01__contact-value {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .footer-01__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-gutter-default);
    padding-block: var(--spacing-md);
    border-top: var(--border-size-sm) solid var(--color-border-default);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--font-leading-md);
  }

  .footer-01__legal-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-gutter-default);
  }

  .footer-01__consent-button {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-link-default);
    cursor: pointer;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .footer-01__consent-button:focus-visible {
    outline: var(--border-size-sm) solid var(--color-border-focus);
    outline-offset: var(--spacing-xxs);
  }

  .footer-01__consent-button:hover {
    color: var(--color-text-link-hover);
  }

  .footer-01__consent-button:active {
    color: var(--color-text-link-active);
  }

  @media (--md) {
    .footer-01__info {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(15rem, 1.5fr);
      gap: var(--spacing-xl);
    }
  }

  @media (--xl) {
    .footer-01__wrapper {
      grid-template-columns: minmax(0, 35fr) minmax(0, 65fr);
    }

    .footer-01__identity,
    .footer-01__content {
      padding-bottom: var(--spacing-none);
    }

    .footer-01__info {
      grid-template-columns: minmax(8rem, 1fr) minmax(8rem, 1fr) minmax(15rem, 2fr);
      border-top: 0px;
      padding-top: var(--spacing-none);
    }
  }
</style>
