---
interface Props {
  title: string;
  features: Array<{
    title: string;
    description: string;
  }>;
}

const { title, features } = Astro.props;
---

<section class="section marketing-features">
  <div class="wrapper">
    <h2 class="marketing-features__title">{title}</h2>
    <div class="marketing-features__grid">
      {features.map((feature) => (
        <article class="marketing-features__card">
          <h3 class="marketing-features__card-title">{feature.title}</h3>
          <p class="marketing-features__card-description">{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .marketing-features {
    background: var(--color-surface);
  }

  .marketing-features__title {
    margin: 0;
    font-size: 1.875rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .marketing-features__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: var(--space-8);
  }

  .marketing-features__card {
    padding: var(--space-6);
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-1);
  }

  .marketing-features__card-title {
    margin: 0;
    font-weight: 600;
  }

  .marketing-features__card-description {
    margin: var(--space-2) 0 0;
    font-size: 0.875rem;
  }

  @media (min-width: 52.5rem) {
    .marketing-features__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
