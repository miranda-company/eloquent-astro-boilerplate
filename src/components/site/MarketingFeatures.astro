---
interface Props {
  title: string;
  features: Array<{
    title: string;
    description: string;
  }>;
}

const { title, features } = Astro.props;
---

<section class="section marketing-features">
  <div class="wrapper">
    <h2 class="marketing-features__title">{title}</h2>
    <div class="marketing-features__grid">
      {features.map((feature) => (
        <article class="marketing-features__card">
          <h3 class="marketing-features__card-title">{feature.title}</h3>
          <p class="marketing-features__card-description">{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .marketing-features {
    background: var(--color-surface-default);
  }

  .marketing-features__title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--font-tracking-tight);
    line-height: var(--font-leading-xl);
  }

  .marketing-features__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: var(--spacing-4);
  }

  .marketing-features__card {
    padding: var(--spacing-3);
    border: 1px solid color-mix(in srgb, var(--color-text-default) 10%, transparent);
    border-radius: var(--radius-md);
  }

  .marketing-features__card-title {
    margin: 0;
    font-weight: var(--font-weight-bold);
  }

  .marketing-features__card-description {
    margin: var(--spacing-1) 0 0;
    font-size: var(--font-size-sm);
  }

  @media (min-width: 52.5rem) {
    .marketing-features__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
