---
import { siteConfig } from '../../config/site.config';
import '../../styles/button.css';

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const gtmId = import.meta.env.PUBLIC_GTM_CONTAINER_ID;
const enabled =
  siteConfig.features.analytics && siteConfig.features.consentBanner && Boolean(gaId || gtmId);
---

{siteConfig.features.consentBanner && (
  <aside
    id="consent-banner"
    class="consent-banner consent-banner--hidden"
    aria-label="Preferencias de cookies"
    data-enabled={enabled ? 'true' : 'false'}
    data-ga-id={gaId}
    data-gtm-id={gtmId}
  >
    <p class="consent-banner__title">Tu privacidad</p>
    <p class="consent-banner__description">
      Usamos cookies opcionales para medir el uso del sitio. Puedes aceptarlas o rechazarlas.
    </p>
    <div class="consent-banner__actions">
      <button class="button consent-banner__accept" type="button" data-consent="accepted">
        Aceptar
      </button>
      <button class="button consent-banner__reject" type="button" data-consent="rejected">
        Rechazar
      </button>
    </div>
  </aside>
)}
{siteConfig.features.consentBanner && <script>
  const key = 'site-cookie-consent';
  const banner = document.querySelector<HTMLElement>('#consent-banner');
  const loadAnalytics = () => {
    if (
      !banner ||
      banner.dataset.enabled !== 'true' ||
      document.querySelector('[data-analytics-loader]')
    )
      return;
    const gaId = banner.dataset.gaId;
    const gtmId = banner.dataset.gtmId;
    const script = document.createElement('script');
    script.async = true;
    script.dataset.analyticsLoader = 'true';
    const analyticsWindow = window as typeof window & {
      dataLayer?: unknown[];
      gtag?: (...args: unknown[]) => void;
    };
    if (gtmId) {
      script.src = `https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(gtmId)}`;
      analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
      analyticsWindow.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
    } else if (gaId) {
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`;
      analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
      analyticsWindow.gtag = (...args) => analyticsWindow.dataLayer?.push(args);
      analyticsWindow.gtag('js', new Date());
      analyticsWindow.gtag('config', gaId);
    }
    document.head.append(script);
  };
  const state = localStorage.getItem(key);
  if (state === 'accepted') loadAnalytics();
  else if (!state && banner) banner.classList.remove('consent-banner--hidden');
  document.querySelectorAll<HTMLElement>('[data-consent]').forEach((button) =>
    button.addEventListener('click', () => {
      const value = button.dataset.consent || 'rejected';
      localStorage.setItem(key, value);
      banner?.classList.add('consent-banner--hidden');
      if (value === 'accepted') loadAnalytics();
    }),
  );
  document
    .querySelectorAll<HTMLElement>('[data-open-consent]')
    .forEach((button) =>
      button.addEventListener('click', () => banner?.classList.remove('consent-banner--hidden')),
    );
</script>}

<style>
  .consent-banner {
    position: fixed;
    inset-inline: var(--space-4);
    bottom: var(--space-4);
    z-index: 40;
    width: min(100% - 2 * var(--space-4), 36rem);
    margin-inline: auto;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    background: var(--color-foreground);
    color: var(--color-background);
    box-shadow: var(--shadow-2);
  }

  .consent-banner--hidden {
    display: none;
  }

  .consent-banner__title {
    margin: 0;
    font-weight: 600;
  }

  .consent-banner__description {
    margin: var(--space-1) 0 0;
    font-size: 0.875rem;
  }

  .consent-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .consent-banner__accept,
  .consent-banner__reject {
    padding: var(--space-2) var(--space-4);
  }

  .consent-banner__accept {
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .consent-banner__reject {
    border-color: color-mix(in srgb, var(--color-background) 50%, transparent);
  }
</style>
