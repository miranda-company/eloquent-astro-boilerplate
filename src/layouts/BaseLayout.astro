---
import ConsentManager from '../components/site/ConsentManager.astro';
import Footer from '../components/site/Footer.astro';
import Header from '../components/site/Header.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import ScrollControls from '../components/site/ScrollControls.astro';
import { getFigmaTokenStyles } from '../config/figma-tokens-adapter';
import { siteConfig } from '../config/client-config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}
const {
  title = siteConfig.seo.defaultTitle,
  description = siteConfig.seo.defaultDescription,
  image = siteConfig.seo.defaultOgImage,
  ogType = 'website',
  noindex = false,
  structuredData,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, siteConfig.url).toString();
const socialImage = image ? new URL(image, siteConfig.url).toString() : undefined;
const figmaTokenStyles = getFigmaTokenStyles();
---

<!doctype html>
<html
  lang={siteConfig.defaultLocale}
  class:list={[
    'site',
    {
      'site--sticky-header': siteConfig.features.stickyHeader,
      'site--wireframe': siteConfig.features.wireframe,
    },
  ]}
>
  <head>
    <style is:global set:html={figmaTokenStyles}></style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{title}</title>
    {structuredData && !noindex && <JsonLd data={structuredData} />}
  </head>
  <body id="top">
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
      <ScrollControls />
    </main>
    <Footer />
    <ConsentManager />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 50;
    transform: translateY(-200%);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: var(--color-text-default);
    color: var(--color-surface-default);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
