---
import ConsentManager from '../components/site/ConsentManager.astro';
import Footer from '../components/site/Footer.astro';
import Header from '../components/site/Header.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { resolveSemanticColors, siteConfig } from '../config/site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  showNavigation?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}
const {
  title = siteConfig.seo.defaultTitle,
  description = siteConfig.seo.defaultDescription,
  image = siteConfig.seo.defaultOgImage,
  ogType = 'website',
  noindex = false,
  showNavigation = true,
  structuredData,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, siteConfig.url).toString();
const socialImage = image ? new URL(image, siteConfig.url).toString() : undefined;
const semanticColors = resolveSemanticColors(siteConfig.colors);
const themeStyle = [
  ...Object.entries(siteConfig.theme).map(([token, value]) => `--${token}: ${value}`),
  ...Object.entries(semanticColors).map(([token, value]) => `--color-${token}: ${value}`),
  ...Object.entries(siteConfig.colors.palettes).flatMap(([palette, shades]) =>
    Object.entries(shades).map(([shade, value]) => `--palette-${palette}-${shade}: ${value}`),
  ),
].join(';');
---

<!doctype html>
<html lang={siteConfig.defaultLocale} style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{title}</title>
    {structuredData && !noindex && <JsonLd data={structuredData} />}
  </head>
  <body class:list={{ wire: siteConfig.features.wireframe }}>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <Header showNavigation={showNavigation} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ConsentManager />
  </body>
</html>
