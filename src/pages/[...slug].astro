---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPageLayout from '../layouts/LegalPageLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft && Boolean(data.slug));
  return pages.map((page) => ({ params: { slug: page.data.slug }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---

{page.data.template === 'legal' && page.data.legal ? (
  <LegalPageLayout title={page.data.title} description={page.data.description} {...page.data.legal}>
    <Content />
  </LegalPageLayout>
) : (
  <BaseLayout title={page.data.title} description={page.data.description}>
    <article class="section page-content">
      <div class="wrapper page-content__wrapper">
        <h1 class="page-content__title">{page.data.title}</h1>
        <Content />
      </div>
    </article>
  </BaseLayout>
)}

<style>
  .page-content__wrapper {
    max-width: var(--max-width-md);
  }

  .page-content__title {
    margin: 0;
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--font-tracking-tight);
  }

  :global(.page-content > * + *) {
    margin-top: var(--size-2);
  }

  :global(.page-content h2) {
    margin-top: var(--size-4);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
  }
</style>
